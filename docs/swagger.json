                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "login.GetAccountLinkConfirmationAPIResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/login.GetAccountLinkConfirmationResponse"
                },
                "message": {
                    "type": "string",
                    "example": "account link confirmation retrieved successfully"
                }
            }
        },
        "login.GetAccountLinkConfirmationResponse": {
            "type": "object",
            "properties": {
                "display_name_snapshot": {
                    "type": "string",
                    "example": "John Doe"
                },
                "email_snapshot": {
                    "type": "string",
                    "example": "user@gmail.com"
                },
                "id": {
                    "type": "string",
                    "example": "01a0f359-093b-737a-963a-80f7ca6768ed"
                },
                "provider": {
                    "type": "string",
                    "example": "google"
                },
                "user_display_name": {
                    "type": "string",
                    "example": "John Doe"
                },
                "user_email": {
                    "type": "string",
                    "example": "user@example.com"
                }
            }
        },
        "login.LoginGoogleRequest": {
            "type": "object",
            "required": [
                "id_token"
            ],
            "properties": {
                "id_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJSUzI1NiIsImtpZCI6ImV4YW1wbGUifQ..."
                }
            }
        },
        "login.LoginGoogleSuccessAPIResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/login.LoginGoogleSuccessData"
                },
                "message": {
                    "type": "string",
                    "example": "login successful"
                }
            }
        },
        "login.LoginGoogleSuccessData": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiJ9.example-access-token"
                },
                "outcome": {
                    "type": "string",
                    "example": "authenticated"
                },
                "refresh_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiJ9.example-refresh-token"
                },
                "user": {
                    "$ref": "#/definitions/login.LoginUser"
                }
            }
        },
        "login.LoginManualAPIResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/login.LoginManualResponse"
                },
                "message": {
                    "type": "string",
                    "example": "login successful"
                }
            }
        },
        "login.LoginManualRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "maxLength": 254,
                    "example": "user@example.com"
                },
                "password": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 8,
                    "example": "password123"
                }
            }
        },
        "login.LoginManualResponse": {
            "type": "object",
            "properties": {
