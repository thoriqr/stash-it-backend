{
    "swagger": "2.0",
    "info": {
        "description": "REST API for Stash It.",
        "title": "Stash It API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/auth/login": {
            "post": {
                "description": "Authenticate a user using email and password and create a new session.\nPossible error codes:\n- VALIDATION_ERROR\n- INVALID_CREDENTIALS\n- INTERNAL_SERVER_ERROR",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Login"
                ],
                "summary": "Login with email and password",
                "parameters": [
                    {
                        "description": "Login request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/login.LoginManualRequest"
                        }
                    },
                    {
                        "type": "string",
                        "description": "Client platform",
                        "name": "X-Platform",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Client installation ID (UUID)",
                        "name": "X-Installation-ID",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Client device name",
                        "name": "X-Device-Name",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Client user agent",
                        "name": "User-Agent",
                        "in": "header"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/login.LoginManualAPIResponse"
                        }
                    },
                    "400": {
                        "description": "Validation error",
                        "schema": {
                            "$ref": "#/definitions/swagger.ValidationErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Invalid email or password",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    }
                }
            }
        },
        "/auth/login/google": {
            "post": {
                "description": "Authenticate a user using a Google ID token.\nThe response contains one of three outcomes:\n- authenticated: the user is authenticated and access/refresh tokens are returned.\n- account_link_required: the user must confirm linking the Google account.\n- registration_required: the user must continue the registration flow.\nPossible error codes:\n- VALIDATION_ERROR\n- INVALID_GOOGLE_TOKEN\n- INTERNAL_SERVER_ERROR",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Login"
                ],
                "summary": "Login with Google",
                "parameters": [
                    {
                        "description": "Google login request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/login.LoginGoogleRequest"
                        }
                    },
                    {
                        "type": "string",
                        "description": "Client platform",
                        "name": "X-Platform",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Client installation ID (UUID)",
                        "name": "X-Installation-ID",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Client device name",
                        "name": "X-Device-Name",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Client user agent",
                        "name": "User-Agent",
                        "in": "header"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/login.LoginGoogleSuccessAPIResponse"
                        }
                    },
                    "400": {
                        "description": "Validation error",
                        "schema": {
                            "$ref": "#/definitions/swagger.ValidationError"
                        }
                    },
                    "401": {
                        "description": "Invalid Google ID token",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    }
                }
            }
        },
        "/auth/login/google/account-link/{confirmation_id}": {
            "get": {
                "description": "Retrieve an active Google account link confirmation.\nPossible error codes:\n- BAD_REQUEST\n- ACCOUNT_LINK_CONFIRMATION_INVALID\n- INTERNAL_SERVER_ERROR",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Login"
                ],
                "summary": "Get account link confirmation",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Account link confirmation ID",
                        "name": "confirmation_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/login.GetAccountLinkConfirmationAPIResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid confirmation ID",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Account link confirmation is invalid",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    }
                }
            }
        },
        "/auth/login/google/account-link/{confirmation_id}/confirm": {
            "post": {
                "description": "Confirm a Google account link and create an authenticated session.\nPossible error codes:\n- BAD_REQUEST\n- ACCOUNT_LINK_CONFIRMATION_INVALID\n- AUTH_IDENTITY_ALREADY_EXISTS\n- INTERNAL_SERVER_ERROR",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Login"
                ],
                "summary": "Confirm Google account link",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Account link confirmation ID",
                        "name": "confirmation_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Client platform",
                        "name": "X-Platform",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Client installation ID (UUID)",
                        "name": "X-Installation-ID",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Client device name",
                        "name": "X-Device-Name",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Client user agent",
                        "name": "User-Agent",
                        "in": "header"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/login.LoginGoogleSuccessAPIResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid confirmation ID or session metadata",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Account link confirmation is invalid or auth identity already exists",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    }
                }
            }
        },
        "/auth/register/continuation": {
            "get": {
                "description": "Validate and retrieve the registration continuation associated with the continuation token.\nPossible error codes:\n- REGISTRATION_CONTINUATION_REQUIRED\n- REGISTRATION_CONTINUATION_CONSUMED\n- REGISTRATION_CONTINUATION_EXPIRED\n- REGISTRATION_NOT_PENDING\n- REGISTRATION_EXPIRED\n- INTERNAL_SERVER_ERROR",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Registration"
                ],
                "summary": "Get registration continuation",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Registration continuation token",
                        "name": "X-Registration-Continuation",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/registration.GetRegistrationContinuationAPIResponse"
                        }
                    },
                    "401": {
                        "description": "Registration continuation token is required",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Registration continuation is invalid or expired",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    }
                }
            }
        },
        "/auth/register/finalize/manual": {
            "post": {
                "description": "Complete a manual registration using a valid registration continuation token.\nPossible error codes:\n- REGISTRATION_CONTINUATION_CONSUMED\n- REGISTRATION_CONTINUATION_EXPIRED\n- REGISTRATION_NOT_PENDING\n- REGISTRATION_EXPIRED\n- INVALID_REGISTRATION_TYPE\n- USER_ALREADY_EXISTS\n- INTERNAL_SERVER_ERROR",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Registration"
                ],
                "summary": "Finalize manual registration",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Registration continuation token",
                        "name": "X-Registration-Continuation",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Finalize registration request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/registration.FinalizeManualRegistrationRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/registration.FinalizeManualRegistrationAPIResponse"
                        }
                    },
                    "400": {
                        "description": "Validation error",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Registration continuation token is required",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Registration cannot be finalized",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    }
                }
            }
        },
        "/auth/register/finalize/social": {
            "post": {
                "description": "Complete a social registration using a valid registration continuation token and create an authenticated session.\nPossible error codes:\n- REGISTRATION_CONTINUATION_CONSUMED\n- REGISTRATION_CONTINUATION_EXPIRED\n- REGISTRATION_NOT_PENDING\n- REGISTRATION_EXPIRED\n- INVALID_REGISTRATION_TYPE\n- USER_ALREADY_EXISTS\n- AUTH_IDENTITY_ALREADY_EXISTS\n- INTERNAL_SERVER_ERROR",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Registration"
                ],
                "summary": "Finalize social registration",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Registration continuation token",
                        "name": "X-Registration-Continuation",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Client platform",
                        "name": "X-Platform",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Client installation ID (UUID)",
                        "name": "X-Installation-ID",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Client device name",
                        "name": "X-Device-Name",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Client user agent",
                        "name": "User-Agent",
                        "in": "header"
                    },
                    {
                        "description": "Finalize social registration request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/registration.FinalizeSocialRegistrationRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/registration.FinalizeSocialRegistrationAPIResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Registration continuation token is required",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Registration cannot be finalized",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    }
                }
            }
        },
        "/auth/register/manual": {
            "post": {
                "description": "Start a manual registration flow using an email address.\nPossible error codes:\n- VALIDATION_ERROR\n- REGISTRATION_ALREADY_COMPLETED\n- REGISTRATION_ALREADY_EXISTS\n- INTERNAL_SERVER_ERROR",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Registration"
                ],
                "summary": "Register with email",
                "parameters": [
                    {
                        "description": "Registration request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/registration.RegisterRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/registration.RegisterAPIResponse"
                        }
                    },
                    "400": {
                        "description": "Validation error",
                        "schema": {
                            "$ref": "#/definitions/swagger.ValidationErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Registration conflict",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    }
                }
            }
        },
        "/auth/register/verification/{verification_id}": {
            "get": {
                "description": "Get the current status of a registration verification request.\nPossible error codes:\n- BAD_REQUEST\n- RESOURCE_NOT_FOUND\n- CONFLICT\n- INTERNAL_SERVER_ERROR",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Registration"
                ],
                "summary": "Get registration verification",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Verification ID",
                        "name": "verification_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/registration.GetVerificationResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid verification ID",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Verification not found",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Verification is no longer pending",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    }
                }
            }
        },
        "/auth/register/verification/{verification_id}/pin": {
            "post": {
                "description": "Generate and send a verification PIN for a pending registration.\nPossible error codes:\n- VERIFICATION_NOT_PENDING\n- REGISTRATION_NOT_PENDING\n- REGISTRATION_EXPIRED\n- RESOURCE_NOT_FOUND\n- INTERNAL_SERVER_ERROR",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Registration"
                ],
                "summary": "Create verification PIN",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Verification ID",
                        "name": "verification_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/registration.CreatePINAPIResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid verification ID",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Verification not found",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Verification or registration conflict",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    }
                }
            }
        },
        "/auth/register/verification/{verification_id}/resend": {
            "post": {
                "description": "Generate and send a new verification PIN for a pending registration.\nPossible error codes:\n- VERIFICATION_NOT_PENDING\n- REGISTRATION_NOT_PENDING\n- REGISTRATION_EXPIRED\n- VERIFICATION_RESEND_COOLDOWN\n- RESOURCE_NOT_FOUND\n- INTERNAL_SERVER_ERROR",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Registration"
                ],
                "summary": "Resend verification PIN",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Verification ID",
                        "name": "verification_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/registration.ResendVerificationAPIResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid verification ID",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Verification not found",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Verification or registration conflict",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/swagger.APIErrorResponse"
                        }
                    }
                }
            }
        },
        "/auth/register/verification/{verification_id}/verify": {
            "post": {
                "description": "Verify a registration using the verification PIN.\nPossible error codes:\n- VERIFICATION_NOT_PENDING\n- REGISTRATION_NOT_PENDING\n- REGISTRATION_EXPIRED\n- VERIFICATION_CODE_ATTEMPTS_EXCEEDED\n- INVALID_VERIFICATION_CODE\n- RESOURCE_NOT_FOUND\n- INTERNAL_SERVER_ERROR",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Registration"
                ],
                "summary": "Verify registration",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Verification ID",
                        "name": "verification_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Verification request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/registration.VerifyRegistrationRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/registration.VerifyRegistrationAPIResponse"
                        }
                    },
                    "400": {
