# Copy this file to .env.<APP_ENV> and fill in real values.
# Never commit a populated environment file: .env.* is gitignored.

# Change this to the name of the environment file you use on the server.
APP_ENV=development

DATABASE_URL=postgres://user:password@localhost:5432/stash_it?sslmode=disable
REDIS_URL=redis://localhost:6379/0

VERIFICATION_CODE_SECRET=replace-with-a-random-secret
ACCESS_TOKEN_SECRET=replace-with-a-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_ID=
SESSION_CLEANUP_SECRET=

# Outbound email: dev | brevo | none
#
# development defaults to dev. A non-development build defaults to none, which
# refuses every send; set brevo to deliver PINs.
EMAIL_PROVIDER=dev

# Required when EMAIL_PROVIDER=brevo.
# BREVO_API_KEY=
# EMAIL_FROM_ADDRESS=no-reply@example.com
# EMAIL_FROM_NAME=Stash It
# EMAIL_TIMEOUT_SECONDS=10

# Optional tuning. Unset values use the defaults documented in internal/config.
# PASSWORD_WORK_CONCURRENCY=1
# PASSWORD_WORK_WAIT_MS=1000
# PIN_EMAIL_BUDGET_PER_EMAIL_MAX=10
# PIN_EMAIL_BUDGET_GLOBAL_MAX=250
# PIN_EMAIL_BUDGET_WINDOW_SECONDS=86400

# Client address resolution. Leave at peer unless the API runs behind a proxy.
# CLIENT_IP_SOURCE=peer
# TRUSTED_PROXIES=
# TRUSTED_PROXY_HEADER=X-Forwarded-For
